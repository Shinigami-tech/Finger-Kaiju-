<!--
  Panel, Divider, Button, ButtonIcon, and ButtonLabel come from the bundled
  Horizon kit. RectangleGoggles and LogIn are bundled Lucide icon components.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 344px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 48px;
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .sub-heading {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    width: 100%;
    margin-top: 10px;
  }

  .sub-heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .controls-title {
    width: 100%;
    margin-top: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #c2410c;
  }

  .control {
    width: 100%;
    margin-top: 4px;
    font-size: 12px;
    line-height: 15px;
    color: #4a4a4a;
  }

  .control:dark {
    color: rgba(255, 255, 255, 0.75);
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">FINGER KAIJU</div>
    <Divider></Divider>
    <div class="sub-heading">
      Your desk becomes a tiny Tokyo and you are a giant, chubby hamster. Smash the goals, gnaw and throw cars, eat seeds and win 3 stars per level: finish, be fast, hurt nobody. GOD MODE (Rampage, Heli Hunt): your hands become hamster paws.
    </div>
    <div class="controls-title">CAMPAIGN (QUEST)</div>
    <div class="control">Left stick walk  |  A punch / throw  |  B jump on roofs</div>
    <div class="control">X grab a car, hold X to gnaw  |  right stick: zoom</div>
    <div class="control">Hands: pinch the ground to walk, pinch a building to smash it</div>
    <div class="control">Grip + point at any surface: move the city there</div>
    <div class="controls-title">DESKTOP</div>
    <div class="control">WASD walk, Shift run, J punch, E grab (hold = gnaw), Space jump, +/- zoom</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter Mixed Reality</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
