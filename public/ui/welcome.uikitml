<!--
  Panel, Divider, Button, ButtonIcon, and ButtonLabel come from the bundled
  Horizon kit. RectangleGoggles and LogIn are bundled Lucide icon components.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 344px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    height: 48px;
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .sub-heading {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    width: 100%;
    margin-top: 10px;
  }

  .sub-heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .controls-title {
    width: 100%;
    margin-top: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #c2410c;
  }

  .control {
    width: 100%;
    margin-top: 4px;
    font-size: 12px;
    line-height: 15px;
    color: #4a4a4a;
  }

  .control:dark {
    color: rgba(255, 255, 255, 0.75);
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 16px;
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">FINGER KAIJU</div>
    <Divider></Divider>
    <div class="sub-heading">
      Your desk becomes a tiny city. Your hand becomes a giant monster. Put on a Quest, enter mixed reality and pick a game: Blitz, Heli Hunt, Missions or Rampage.
    </div>
    <div class="controls-title">HANDS</div>
    <div class="control">Touch / punch: smash buildings</div>
    <div class="control">Pinch or fist: grab, rip off, throw</div>
    <div class="control">Squeeze the fist: crush what you hold</div>
    <div class="control">Slam your palm: earthquake</div>
    <div class="control">Pinch with both hands: zoom and rotate</div>
    <div class="controls-title">DESKTOP</div>
    <div class="control">Click a card to play, click to smash, Space: quake</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter Mixed Reality</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
